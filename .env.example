# Nebius Token Factory / Nebius AI Studio API Key
# Obtain your API key from https://tokenfactory.nebius.ai/ or https://studio.nebius.ai/
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius AI Studio Base API URL (OpenAI-compatible)
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# NVIDIA Nemotron Model Identifier hosted on Nebius Token Factory
# Recommended models:
# - nvidia/Llama-3.1-Nemotron-70B-Instruct-HF (Default & Highly Recommended)
# - nvidia/nemotron-4-340b-instruct
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Server Configuration
HOST=127.0.0.1
PORT=8000
